<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Literacy Learning Studio | Marsha Kerr Talley</title><style>
:root{--navy:#173d58;--teal:#007f82;--coral:#f46d64;--gold:#f7bd4c;--purple:#7755bd;--mint:#dff7ed;--paper:#fffdf7;--ink:#20354a}*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#e7f7f2,#fff2dd 55%,#eae7ff);color:var(--ink);font:16px/1.5 system-ui,Arial}header{padding:30px max(18px,calc((100vw - 1080px)/2));background:linear-gradient(115deg,#153b58,#008f8b);color:white}h1{font-size:clamp(30px,5vw,52px);margin:4px 0}header p{max-width:700px}main{max-width:1100px;margin:auto;padding:18px}.eyebrow{font-weight:800;letter-spacing:2px;text-transform:uppercase;font-size:12px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:18px 0}.toolbar>*{flex:1 1 170px}.tabs{display:flex;gap:9px;overflow:auto;padding:5px 0 14px}.tabs button{white-space:nowrap}.panel{display:none}.panel.active{display:block}.card{background:white;border:1px solid #dce9e7;border-radius:20px;padding:clamp(17px,3vw,28px);margin:15px 0;box-shadow:0 8px 26px #173d5812}.card h2{margin:0 0 7px;font-size:26px}button,.btn{border:0;border-radius:13px;background:var(--navy);color:white;padding:12px 17px;font:inherit;font-weight:750;cursor:pointer}button:hover{filter:brightness(1.08)}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[draggable]:focus-visible{outline:3px solid #f6a334;outline-offset:2px}.tabs button{background:#fff;color:var(--navy);border:2px solid #cbdedb}.tabs button.active{background:var(--navy);color:white}.secondary{background:var(--teal)}.coral{background:var(--coral);color:#2e2323}.purple{background:var(--purple)}.gold{background:var(--gold);color:#30250c}label{font-weight:700;display:block;margin:12px 0 5px}input,textarea,select{font:inherit;border:2px solid #bfd3d0;border-radius:12px;padding:12px;width:100%;background:#fff}textarea{min-height:105px;resize:vertical}.small{color:#526578;font-size:14px}.chips{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.chip{background:#e4f4f0;border:2px solid #8fc6c0;color:#173d58;padding:11px 15px;border-radius:13px;cursor:grab;font-weight:750;user-select:none}.chip.selected{background:#ffe29b;border-color:#d68e21}.drop{border:3px dashed #8eb8b3;background:#f4fbfa;min-height:70px;padding:12px;border-radius:14px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:15px}.tile{border-radius:18px;padding:20px;background:#e8f5ff}.tile:nth-child(2){background:#fff1d5}.tile:nth-child(3){background:#f1e9ff}.tile:nth-child(4){background:#e5f9e9}.tile h3{margin-top:0}.frayer{display:grid;grid-template-columns:1fr 1fr;gap:12px}.frayer>div{background:#f3f9fa;padding:14px;border-radius:15px}.frayer>div:nth-child(2){background:#fff2df}.frayer>div:nth-child(3){background:#efe9fc}.frayer>div:nth-child(4){background:#e8f7e8}.burger{max-width:560px;margin:15px auto}.bun,.filling{padding:17px;border-radius:24px;text-align:center;font-weight:850;margin:5px 0;transition:transform .2s}.bun{background:#e6a657;color:#382313}.bun.top{border-radius:100px 100px 20px 20px;padding-top:32px}.bun.bottom{border-radius:18px 18px 65px 65px}.filling.b{background:#f5cb50}.filling.c{background:#7cbf72}.filling.ready{transform:scale(1.025);box-shadow:0 0 0 4px #fff,0 0 0 7px #2b8b82}.progress{height:15px;border-radius:20px;background:#dce9e7;overflow:hidden}.progress>div{height:100%;background:linear-gradient(90deg,#00a69d,#f3b448);width:0;transition:width .3s}.feedback{min-height:30px;font-weight:750;color:#09695d}.reading{font-size:clamp(18px,2.5vw,23px);line-height:1.9;background:#fff9e9;padding:22px;border-radius:16px}.sentence{background:#f2f7fc;padding:18px;border-radius:14px;font-size:21px}.blank{display:inline-block;min-width:110px;border-bottom:3px solid var(--purple);text-align:center}.choice{margin:6px;background:#f0e8ff;color:#352b5e}.choice.active{background:var(--purple);color:white}.hide{display:none!important}footer{text-align:center;padding:25px;color:#536576}.notice{background:#fff1d6;border-left:5px solid #e0a33d;padding:12px;border-radius:8px}.printonly{display:none}@media(max-width:650px){.frayer{grid-template-columns:1fr}.card{padding:17px}}@media print{header,.tabs,.toolbar,.no-print,button{display:none!important}.panel{display:block!important}.card{box-shadow:none;break-inside:avoid}.printonly{display:block}}
</style></head><body><header><div class="eyebrow">Marsha Kerr Talley · Interactive learning</div><h1>Literacy Learning Studio <span aria-hidden="true">✦</span></h1><p>Touch, listen, move, build and explain. Explore words and ideas at your own pace.</p></header><main><div class="toolbar"><div><label for="week">Weekly theme</label><select id="week"></select></div><div><label for="path">My learning pathway</label><select id="path"><option>Foundation</option><option selected>Developing</option><option>Extend</option></select></div><div><label for="student">Student code (optional)</label><input id="student" placeholder="Use a code, not a full name"></div></div><nav class="tabs no-print" aria-label="Activities"><button class="active" data-tab="home">🏠 Studio</button><button data-tab="words">🔊 Word Lab</button><button data-tab="sentences">🧩 Sentence Builder</button><button data-tab="read">📖 Reading Quest</button><button data-tab="burger">🍔 ABC Burger</button><button data-tab="teacher">⚙️ Teacher Studio</button></nav>
<section id="home" class="panel active"><div class="card"><h2>Welcome to your learning studio</h2><p>Choose a learning station above. Every station lets you <strong>do something</strong>, not just read instructions.</p><div class="grid"><div class="tile"><h3>🔊 Hear & discover</h3>Listen to a word, explore meaning and create a visual connection.</div><div class="tile"><h3>🧩 Move & build</h3>Arrange word tiles to make a complete sentence.</div><div class="tile"><h3>📖 Read & reason</h3>Read a short text, answer questions and explain your thinking.</div><div class="tile"><h3>🍔 Build your argument</h3>Layer an ABC paragraph like a hamburger.</div></div><p class="notice">Your work stays in this browser session unless you download or print it. Avoid entering confidential student information on a shared device.</p></div></section>
<section id="words" class="panel"><div class="card"><h2>🔊 Word Lab</h2><p>Hear the word, say it, build its meaning, then use it in a sentence.</p><div class="toolbar"><button class="purple" id="hear">▶ Hear the word</button><button class="secondary" id="hearSentence">▶ Hear an example</button><button class="gold" id="syllables">Tap to reveal word parts</button></div><h2 id="wordDisplay" style="color:var(--purple);font-size:38px"></h2><div id="wordParts" class="feedback"></div><div class="frayer"><div><label for="definition">Meaning in my own words</label><textarea id="definition"></textarea></div><div><label for="example">Example or situation</label><textarea id="example"></textarea></div><div><label for="related">Synonym / related idea</label><textarea id="related"></textarea></div><div><label for="nonexample">Antonym / non-example</label><textarea id="nonexample"></textarea></div></div><label for="mySentence">Use the word in your own sentence</label><textarea id="mySentence"></textarea><p class="small">Illustration challenge: draw a picture on paper, or describe your picture in the example box. Voice playback uses your device's speech feature when available.</p></div></section>
<section id="sentences" class="panel"><div class="card"><h2>🧩 Sentence Builder</h2><p>Drag a word tile into the sentence zone, or tap tiles in the correct order. You can undo or reset.</p><div class="chips" id="tiles"></div><div class="drop" id="sentenceDrop" aria-label="Sentence building area"></div><div class="toolbar"><button id="checkSentence">Check my sentence</button><button class="secondary" id="undoSentence">Undo</button><button class="coral" id="resetSentence">Start again</button><button class="purple" id="speakBuilt">▶ Hear my sentence</button></div><div id="sentenceFeedback" class="feedback" aria-live="polite"></div><label for="sentenceExtend">Now extend your sentence: explain why, when or how.</label><textarea id="sentenceExtend" placeholder="Because… / Although… / For example…"></textarea></div></section>
<section id="read" class="panel"><div class="card"><h2>📖 Reading Quest</h2><div class="toolbar"><button id="speakPassage" class="purple">▶ Listen to the passage</button><button id="stopVoice" class="secondary">■ Stop reading</button></div><h3 id="passageTitle"></h3><div id="passageText" class="reading"></div><div id="questions"></div><div class="progress" aria-label="Questions answered"><div id="questionProgress"></div></div><p id="questionCount" class="small"></p><label for="evidence">Which words in the text support your answer? Explain.</label><textarea id="evidence"></textarea><label for="challenge">Challenge: What could someone reasonably disagree with, and why?</label><textarea id="challenge"></textarea></div></section>
<section id="burger" class="panel"><div class="card"><h2>🍔 Build an ABC Paragraph</h2><p id="promptText" class="notice"></p><div class="burger"><div class="bun top" id="layerA">A — Answer with a because statement</div><div class="filling b" id="layerB">B — Back it up with evidence</div><div class="filling c" id="layerC">C — Connect evidence and reasoning</div><div class="bun bottom">A complete, convincing paragraph</div></div><label for="answerA">A — I think… because…</label><textarea id="answerA" placeholder="I believe… because…"></textarea><label for="answerB">B — For example… (use evidence from the reading)</label><textarea id="answerB" placeholder="For example, the text explains…"></textarea><label for="answerC">C — This shows… (explain why the evidence matters)</label><textarea id="answerC" placeholder="This matters because…"></textarea><div class="toolbar"><button id="assemble">Assemble my paragraph</button><button class="purple" id="speakParagraph">▶ Listen to my paragraph</button></div><div id="assembled" class="reading" aria-live="polite">Your paragraph will appear here.</div><p class="small">The visual layers highlight as you complete each part. Read your paragraph aloud, revise it, and explain how the evidence supports your answer.</p></div></section>
<section id="teacher" class="panel"><div class="card"><h2>⚙️ Teacher Studio</h2><p>Edit the selected week's activities. Changes apply to this browser session; download the content file to preserve them. To publish changes to a GitHub website, replace the hosted content in the HTML or incorporate the exported JSON into your site.</p><label for="editTitle">Weekly theme</label><input id="editTitle"><label for="editWord">Vocabulary word</label><input id="editWord"><label for="editParts">Word parts (separate with hyphens)</label><input id="editParts"><label for="editExample">Spoken example sentence</label><input id="editExample"><label for="editSentence">Sentence to build (words separated by spaces)</label><input id="editSentence"><label for="editPassageTitle">Reading title</label><input id="editPassageTitle"><label for="editPassage">Reading passage</label><textarea id="editPassage" rows="6"></textarea><label for="editPrompt">ABC question</label><textarea id="editPrompt"></textarea><button id="applyWeek">Apply to this week</button><button class="secondary" id="exportContent">Download weekly content JSON</button><label for="importContent">Import a saved content JSON file</label><input id="importContent" type="file" accept=".json,application/json"><hr><h3>Student work</h3><button id="downloadWork">Download my work as text</button><button class="secondary" id="printWork">Print / Save PDF</button><p class="small">There is no server, student login, database or automatic submission. Audio depends on browser speech support. Dragging has a tap alternative for accessibility.</p></div></section></main><footer>Developed by <strong>Marsha Kerr Talley</strong> · Live Inspired | Turning Pain Into Possibility™<br>© 2026 Marsha Kerr Talley. All rights reserved.</footer>
<script>
'use strict';
const themes=['Belonging and Community','Choices and Consequences','Healthy Routines','Learning from Mistakes','The School Garden','Digital Communication','Teamwork and Leadership','Water and Conservation','Fairness and Rules','Community Problem-Solving','Media and Persuasion','Progress and Possibility'];
const words=['belonging','consequence','routine','resilience','cultivate','communication','collaboration','conservation','fairness','initiative','persuasion','reflection'];
const sentences=['Everyone deserves a place to belong.','Our choices can affect other people.','A healthy routine supports learning.','Mistakes can help us learn new skills.','The students planted vegetables in the garden.','Clear messages help people understand each other.','Our team solved the problem together.','Saving water protects our community.','Fair rules should apply to everyone.','Neighbours worked together to improve the park.','A strong argument needs reliable evidence.','I can explain how my thinking has changed.'];
const passages=[
'When a new student joined the class, several classmates invited her to work with them. She was quiet at first, but she soon began to share her ideas. The group discovered that everyone had something valuable to contribute.',
'At lunchtime, Malik found a lost notebook. He could have ignored it, but he took it to the office. Later, the owner thanked him because the notebook contained important revision notes. Malik realised that small choices can have meaningful consequences.',
'Jade decided to prepare her schoolbag each evening. At first, she forgot. She placed a checklist beside the door and practised the routine every night. After a week, she arrived at school with the materials she needed.',
'Ravi made several mistakes while learning to repair a bicycle. Instead of giving up, he asked a neighbour to demonstrate each step. He tried again and eventually fixed the chain. The experience showed him that careful practice can turn mistakes into learning.',
'A class wanted to grow vegetables in an unused corner of the schoolyard. They cleared litter, prepared the soil and planted seedlings. When rain became scarce, they collected water responsibly. The garden gradually became a place for science lessons and teamwork.',
'A message in the class group sounded rude to one student. Another student explained that short messages can be misunderstood without tone of voice. The group agreed to ask questions before making assumptions and to choose respectful words.',
'A school team needed to organise a community clean-up. One student planned the tasks, another gathered materials and others invited volunteers. When their first plan failed, they listened to each other and adjusted it. Their cooperation made the event possible.',
'After several dry weeks, the school noticed that taps were sometimes left running. Students created reminders and checked for leaks. Their actions did not solve every water problem, but they helped the school use its available water more responsibly.',
'Two groups disagreed about how to share the sports field. The prefects listened to both groups and suggested a timetable. Some students wanted more time, but everyone could see how the new arrangement was made. They agreed to review it after two weeks.',
'Residents noticed that the footpath near the school became muddy after rain. They spoke with community members, gathered suggestions and asked local leaders for help. Their first proposal was too expensive, so they developed a smaller plan that could be tested.',
'An advertisement claimed that one study method guaranteed success. A student looked for evidence and found only personal testimonials. She compared the claim with advice from several teachers and concluded that the advertisement had not proved its promise.',
'At the start of term, Andre found it difficult to explain his ideas in writing. He practised short sentences, then paragraphs with evidence. By the end of term, his writing was clearer. He still had skills to develop, but he could describe the progress he had made.'
];
let data=themes.map((title,i)=>({title,word:words[i],parts:words[i].replace(/(.{4})/,'$1-'),example:`The word ${words[i]} is important to this week's learning.`,sentence:sentences[i],passageTitle:title,passage:passages[i],prompt:`What can we learn about ${title.toLowerCase()} from this week's reading?`}));
const $=id=>document.getElementById(id),week=$('week');data.forEach((d,i)=>week.add(new Option(`Week ${i+1} · ${d.title}`,i)));let index=0,built=[],selected=-1;
function speak(t){if(!('speechSynthesis' in window)){alert('Speech playback is not available in this browser.');return;}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='en-GB';u.rate=.84;speechSynthesis.speak(u)}
function current(){return data[index]}
function render(){let d=current();week.options[index].text=`Week ${index+1} · ${d.title}`;$('wordDisplay').textContent=d.word;$('wordParts').textContent='';$('passageTitle').textContent=d.passageTitle;$('passageText').textContent=d.passage;$('promptText').textContent=d.prompt;['Title','Word','Parts','Example','Sentence','PassageTitle','Passage','Prompt'].forEach(k=>{$('edit'+k).value=d[k.charAt(0).toLowerCase()+k.slice(1)]});built=[];drawTiles();drawQuestions();updateBurger()}
function tokens(){return current().sentence.trim().split(/\s+/)}
function drawTiles(){let arr=tokens();let remaining=arr.map((t,i)=>({t,i})).filter(x=>!built.includes(x.i));remaining.sort((a,b)=>(a.t.localeCompare(b.t)));$('tiles').innerHTML='';remaining.forEach(x=>{let b=document.createElement('button');b.className='chip';b.textContent=x.t;b.draggable=true;b.dataset.i=x.i;b.addEventListener('click',()=>addTile(x.i));b.addEventListener('dragstart',e=>e.dataTransfer.setData('text/plain',String(x.i)));$('tiles').append(b)});$('sentenceDrop').innerHTML='';built.forEach(i=>{let b=document.createElement('button');b.className='chip selected';b.textContent=arr[i];b.title='Tap to remove';b.onclick=()=>{built=built.filter(v=>v!==i);drawTiles()};$('sentenceDrop').append(b)})}
function addTile(i){if(!built.includes(i)){built.push(i);drawTiles()}}$('sentenceDrop').addEventListener('dragover',e=>e.preventDefault());$('sentenceDrop').addEventListener('drop',e=>{e.preventDefault();let i=Number(e.dataTransfer.getData('text/plain'));if(Number.isInteger(i))addTile(i)});
$('checkSentence').onclick=()=>{let expected=tokens().join(' '),actual=built.map(i=>tokens()[i]).join(' ');$('sentenceFeedback').textContent=actual===expected?'Excellent! Your sentence is in the correct order.':'Keep trying. Check the first word, word order and punctuation.'};$('undoSentence').onclick=()=>{built.pop();drawTiles()};$('resetSentence').onclick=()=>{built=[];drawTiles();$('sentenceFeedback').textContent=''};$('speakBuilt').onclick=()=>speak(built.map(i=>tokens()[i]).join(' '));
function drawQuestions(){let qs=[`What happened in the passage?`,`Why did the people act as they did?`,`What is one lesson or inference you can draw?`];$('questions').innerHTML=qs.map((q,i)=>`<label for="q${i}">${i+1}. ${q}</label><textarea id="q${i}" class="response"></textarea>`).join('');document.querySelectorAll('.response').forEach(t=>t.addEventListener('input',progress));progress()}
function progress(){let n=[0,1,2].filter(i=>$('q'+i)?.value.trim()).length;$('questionProgress').style.width=(n/3*100)+'%';$('questionCount').textContent=`${n} of 3 responses started`}
function updateBurger(){['A','B','C'].forEach(x=>$('layer'+x).classList.toggle('ready',Boolean($('answer'+x).value.trim())))}['A','B','C'].forEach(x=>$('answer'+x).addEventListener('input',updateBurger));$('assemble').onclick=()=>{$('assembled').textContent=['A','B','C'].map(x=>$('answer'+x).value.trim()).filter(Boolean).join(' ')||'Add your A, B and C ideas to build a paragraph.'};$('speakParagraph').onclick=()=>speak($('assembled').textContent);$('hear').onclick=()=>speak(current().word);$('hearSentence').onclick=()=>speak(current().example);$('syllables').onclick=()=>$('wordParts').textContent=current().parts;$('speakPassage').onclick=()=>speak(current().passage);$('stopVoice').onclick=()=>{if('speechSynthesis' in window)speechSynthesis.cancel()};
week.onchange=()=>{index=Number(week.value);render()};document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===b.dataset.tab))});
$('applyWeek').onclick=()=>{let d=current();['Title','Word','Parts','Example','Sentence','PassageTitle','Passage','Prompt'].forEach(k=>{d[k.charAt(0).toLowerCase()+k.slice(1)]=$('edit'+k).value});render();alert('Changes applied to this browser session. Download your content to keep a copy.')};
function download(name,content,type){let a=document.createElement('a'),url=URL.createObjectURL(new Blob([content],{type}));a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}$('exportContent').onclick=()=>download('literacy-weeks.json',JSON.stringify(data,null,2),'application/json');$('importContent').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let x=JSON.parse(await f.text());if(!Array.isArray(x)||x.length!==12||!x.every(v=>['title','word','parts','example','sentence','passageTitle','passage','prompt'].every(k=>typeof v[k]==='string')))throw Error('Invalid 12-week content file');data=x;render();alert('Weekly content loaded.')}catch(err){alert(err.message)}};
$('downloadWork').onclick=()=>{let d=current();let ids=['definition','example','related','nonexample','mySentence','sentenceExtend','q0','q1','q2','evidence','challenge','answerA','answerB','answerC'];download(`literacy-work-week-${index+1}.txt`,[`Week ${index+1}: ${d.title}`,`Student code: ${$('student').value}`,`Pathway: ${$('path').value}`,...ids.map(id=>`${id}: ${$(id).value}`)].join('\n\n'),'text/plain')};$('printWork').onclick=()=>window.print();render();
</script></body></html>
